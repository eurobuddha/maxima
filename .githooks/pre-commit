#!/bin/sh
# Guardrail — every code change ships with a version bump, and the fast unit
# suite must be green. Real funds, real chain. Do NOT bypass with --no-verify.
staged=$(git diff --cached --name-only); [ -z "$staged" ] && exit 0

# ── 1. Version bump (Android): app/src/** requires a versionCode bump ─────────
code=$(printf '%s\n' "$staged" | grep -E '^app/src/')
if [ -n "$code" ]; then
  sv=$(git show :app/build.gradle 2>/dev/null | grep -E 'versionCode[[:space:]]+[0-9]+' | head -1 | grep -oE '[0-9]+' | head -1)
  hv=$(git show HEAD:app/build.gradle 2>/dev/null | grep -E 'versionCode[[:space:]]+[0-9]+' | head -1 | grep -oE '[0-9]+' | head -1)
  [ -z "$sv" ] && sv=$(grep -E 'versionCode[[:space:]]+[0-9]+' app/build.gradle 2>/dev/null | head -1 | grep -oE '[0-9]+' | head -1)
  if [ -n "$hv" ] && [ "$sv" = "$hv" ]; then
    echo "──────────────────────────────────────────────────────────────────"
    echo "  COMMIT BLOCKED — app/src changed but versionCode did NOT bump (still $hv)."
    echo "  Rule: every code change ships with a version bump (real funds, real chain)."
    echo "  Fix: bump versionCode + versionName in app/build.gradle, stage it, commit again."
    echo "──────────────────────────────────────────────────────────────────"; exit 1
  fi
fi

# ── 2. Fast unit gate: run :core:test when any Java/Gradle source is staged ───
# Core only — it is pure JVM and runs in ~1s. The heavier :server/:maxjar suites
# and the Android build stay in CI so the hook never becomes something to skip.
src=$(printf '%s\n' "$staged" | grep -E '\.java$|build\.gradle$')
if [ -n "$src" ]; then
  echo "pre-commit: running ./gradlew :core:test …"
  if ! ./gradlew :core:test -q >/tmp/maxima-precommit-test.log 2>&1; then
    echo "──────────────────────────────────────────────────────────────────"
    echo "  COMMIT BLOCKED — :core unit tests FAILED. This gate exists because a"
    echo "  media-render regression once shipped that a round-trip test catches."
    echo "  See the failure below; fix it, then commit again (do NOT --no-verify)."
    echo "──────────────────────────────────────────────────────────────────"
    tail -30 /tmp/maxima-precommit-test.log
    exit 1
  fi
fi
exit 0
