<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ux_bg"
    android:orientation="vertical">

    <!-- WhatsApp-style top bar: app name, live status, search, overflow. -->
    <LinearLayout
        android:id="@+id/main_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ux_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title row. On a narrow screen (a foldable's cover display) the icons + status
                 pill leave this column ~110dp: a wrap_content row used to hand the version label
                 the leftover few px, so it wrapped one CHARACTER per line and, baseline-aligned,
                 dragged the title off the top. Now the row is match_parent, the title takes the
                 slack and auto-shrinks (22sp -> 14sp) on one line, the version stays one line. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:gravity="bottom">

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="32dp"
                    android:gravity="bottom|start"
                    android:fontFamily="@font/manrope_extrabold"
                    android:text="@string/app_name"
                    android:textColor="@color/ux_on_header"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeMaxTextSize="22sp"
                    android:autoSizeStepGranularity="1sp"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/main_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="7dp"
                    android:layout_marginBottom="4dp"
                    android:alpha="0.6"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:textColor="@color/ux_on_header"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:alpha="0.45"
                android:letterSpacing="0.02"
                android:text="@string/brand_backend_credit"
                android:textColor="@color/ux_on_header"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/header_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp">

            <View
                android:id="@+id/status_dot"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/status_dot" />

            <TextView
                android:id="@+id/status_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:maxLines="1"
                android:text="starting…"
                android:textColor="@color/ux_on_header"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_main_theme"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Theme"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_theme"
            app:tint="@color/ux_on_header" />

        <ImageButton
            android:id="@+id/btn_main_search"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Search"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_search"
            app:tint="@color/ux_on_header" />

        <ImageButton
            android:id="@+id/btn_main_more"
            android:layout_width="36dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="More"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more"
            app:tint="@color/ux_on_header" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ux_header"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/ux_on_header"
        app:tabIndicatorFullWidth="false"
        app:tabMode="fixed"
        app:tabSelectedTextColor="@color/ux_on_header"
        app:tabTextColor="#99FFFFFF" />

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
