<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ux_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ==== YOUR ADDRESS ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/MaximaSectionLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="YOUR ADDRESS" />

                <TextView
                    android:id="@+id/q_address"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:text="?"
                    android:textColor="@color/ux_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/address"
                style="@style/MaximaMono"
                android:background="@drawable/card_inner"
                android:padding="10dp"
                android:textIsSelectable="true" />

            <TextView
                android:id="@+id/address_note"
                style="@style/MaximaHint"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_copy"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_primary"
                    android:stateListAnimator="@null"
                    android:text="Copy"
                    android:textAllCaps="false"
                    android:textColor="#FF16100A"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_share"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_ghost"
                    android:stateListAnimator="@null"
                    android:text="Share"
                    android:textAllCaps="false"
                    android:textColor="@color/ux_text" />

                <Button
                    android:id="@+id/btn_qr"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_ghost"
                    android:stateListAnimator="@null"
                    android:text="QR"
                    android:textAllCaps="false"
                    android:textColor="@color/ux_text" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==== ADD ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/MaximaSectionLabel"
                android:text="ADD SOMEONE" />

            <EditText
                android:id="@+id/new_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/input"
                android:hint="paste their Mx…@host:port"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:padding="12dp"
                android:textColor="@color/ux_text"
                android:textColorHint="@color/ux_subtext"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btn_add_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_primary"
                android:stateListAnimator="@null"
                android:text="Introduce myself"
                android:textAllCaps="false"
                android:textColor="#FF16100A"
                android:textStyle="bold" />

            <TextView
                style="@style/MaximaHint"
                android:layout_marginTop="8dp"
                android:text="Adding a contact is a handshake. You send them your details; they reply with theirs. Until they reply the link is one-way." />
        </LinearLayout>

        <!-- ==== LIST ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/contacts_label"
                    style="@style/MaximaSectionLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="CONTACTS" />

                <TextView
                    android:id="@+id/q_contacts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="4dp"
                    android:text="?"
                    android:textColor="@color/ux_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contacts_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/contacts_empty"
                style="@style/MaximaHint"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:text="Nobody yet. Paste an address above, or send someone yours." />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
