<?xml version="1.0" encoding="utf-8"?>
<!-- One figure: what it is, what it says, and a "?" that explains it in
     plain English. Built in code so every stat is guaranteed to have one. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/stat_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ux_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/stat_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/ux_subtext"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/stat_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:textColor="@color/ux_accent"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/stat_q"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="2dp"
        android:text="?"
        android:textColor="@color/ux_accent"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
