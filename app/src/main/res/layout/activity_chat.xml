<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ux_bg"
    android:orientation="vertical">

    <!-- WhatsApp-style app bar: back, avatar, name over presence, then video /
         call / overflow. On the header colour, everything is on_header. -->
    <LinearLayout
        android:id="@+id/chat_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ux_header"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btn_chat_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back"
            app:tint="@color/ux_on_header" />

        <TextView
            android:id="@+id/chat_avatar"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/chat_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/manrope_bold"
                android:singleLine="true"
                android:textColor="@color/ux_on_header"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/chat_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.85"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/ux_on_header"
                android:textSize="11.5sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_chat_video"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Video call"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_videocall"
            app:tint="@color/ux_on_header" />

        <ImageButton
            android:id="@+id/btn_chat_call"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice call"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_call"
            app:tint="@color/ux_on_header" />

        <ImageButton
            android:id="@+id/btn_chat_info"
            android:layout_width="38dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Details"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_more"
            app:tint="@color/ux_on_header" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/chat_wallpaper">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/chat_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/ux_subtext"
            android:textSize="14sp"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_scroll_bottom"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="bottom|end"
            android:layout_margin="14dp"
            android:background="@drawable/fab_circle"
            android:contentDescription="Jump to latest"
            android:elevation="4dp"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_down"
            app:tint="@color/ux_text"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Composer: an emoji/field/attach/camera pill + a round send/mic FAB. -->
    <LinearLayout
        android:id="@+id/chat_composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ux_bg"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:paddingTop="6dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/input_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp">

            <ImageButton
                android:id="@+id/btn_chat_emoji"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Emoji"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_emoji"
                app:tint="@color/ux_subtext" />

            <EditText
                android:id="@+id/chat_input"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Message"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textColor="@color/ux_text"
                android:textColorHint="@color/ux_subtext"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btn_chat_attach"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Attach"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_attach"
                app:tint="@color/ux_subtext" />

            <ImageButton
                android:id="@+id/btn_chat_camera"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Camera"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_camera"
                app:tint="@color/ux_subtext" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_chat_send"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/btn_send_circle"
            android:contentDescription="Send"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic"
            android:stateListAnimator="@null"
            app:tint="@color/ux_on_accent" />
    </LinearLayout>
</LinearLayout>
