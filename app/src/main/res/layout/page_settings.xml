<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ux_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ==== IDENTITY ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/MaximaSectionLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="YOUR NAME" />

                <TextView
                    android:id="@+id/q_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:text="?"
                    android:textColor="@color/ux_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/name_field"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/input"
                    android:hint="your name"
                    android:importantForAutofill="no"
                    android:inputType="textNoSuggestions|textCapWords"
                    android:maxLength="32"
                    android:padding="12dp"
                    android:textColor="@color/ux_text"
                    android:textColorHint="@color/ux_subtext"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btn_set_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_primary"
                    android:stateListAnimator="@null"
                    android:text="Set"
                    android:textAllCaps="false"
                    android:textColor="#FF16100A"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/identity_key"
                style="@style/MaximaHint"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:textIsSelectable="true"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- ==== PRIVACY ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/MaximaSectionLabel"
                android:text="PRIVACY" />

            <LinearLayout
                android:id="@+id/settings_privacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ==== SECURITY ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/MaximaSectionLabel"
                android:text="KEYS AND POWER" />

            <LinearLayout
                android:id="@+id/settings_security"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_phrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_ghost"
                android:stateListAnimator="@null"
                android:text="Show seed phrase"
                android:textAllCaps="false"
                android:textColor="@color/ux_error" />

            <Button
                android:id="@+id/btn_battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_ghost"
                android:stateListAnimator="@null"
                android:text="Battery settings"
                android:textAllCaps="false"
                android:textColor="@color/ux_text" />
        </LinearLayout>

        <!-- ==== APPS ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/MaximaSectionLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="APPS USING MAXIMA" />

                <TextView
                    android:id="@+id/q_ipc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:text="?"
                    android:textColor="@color/ux_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/apps_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ==== ABOUT ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/MaximaSectionLabel"
                android:text="ABOUT" />

            <TextView
                android:id="@+id/about"
                style="@style/MaximaHint" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
