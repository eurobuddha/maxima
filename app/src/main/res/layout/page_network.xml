<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ux_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ==== LIVE FIGURES ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/MaximaSectionLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="TRANSPORT" />

                <TextView
                    android:id="@+id/q_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:text="?"
                    android:textColor="@color/ux_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stats_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ==== HOSTS ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/MaximaSectionLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="HOSTS  ·  THEY RELAY YOUR TRAFFIC" />

                <TextView
                    android:id="@+id/q_hosts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:text="?"
                    android:textColor="@color/ux_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hosts_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <EditText
                android:id="@+id/new_relay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/input"
                android:hint="add host:port  e.g. 31.125.188.214:8001"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:padding="12dp"
                android:textColor="@color/ux_text"
                android:textColorHint="@color/ux_subtext"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_add_relay"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_primary"
                    android:stateListAnimator="@null"
                    android:text="Add host"
                    android:textAllCaps="false"
                    android:textColor="#FF16100A"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_relays"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_ghost"
                    android:stateListAnimator="@null"
                    android:text="Manage"
                    android:textAllCaps="false"
                    android:textColor="@color/ux_text" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==== MLS ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/MaximaSectionLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="LOCATION SERVICE  ·  FINDS YOU WHEN YOU MOVE" />

                <TextView
                    android:id="@+id/q_mls"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:text="?"
                    android:textColor="@color/ux_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/mls"
                style="@style/MaximaMono"
                android:background="@drawable/card_inner"
                android:padding="10dp" />

            <EditText
                android:id="@+id/new_mls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/input"
                android:hint="pin a static MLS:  Mx…@host:port"
                android:importantForAutofill="no"
                android:inputType="textNoSuggestions"
                android:padding="12dp"
                android:textColor="@color/ux_text"
                android:textColorHint="@color/ux_subtext"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_set_mls"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_primary"
                    android:stateListAnimator="@null"
                    android:text="Pin"
                    android:textAllCaps="false"
                    android:textColor="#FF16100A"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_clear_mls"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_ghost"
                    android:stateListAnimator="@null"
                    android:text="Use host's"
                    android:textAllCaps="false"
                    android:textColor="@color/ux_text" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==== CONTRIBUTION ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/MaximaSectionLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="WHAT THIS PHONE GIVES BACK" />

                <TextView
                    android:id="@+id/q_contribution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:text="?"
                    android:textColor="@color/ux_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/contribution"
                style="@style/MaximaHint"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:id="@+id/contrib_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_contrib_toggle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/btn_ghost"
                    android:stateListAnimator="@null"
                    android:text="Turn off"
                    android:textAllCaps="false"
                    android:textColor="@color/ux_text" />

                <Button
                    android:id="@+id/btn_contrib_metered"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_ghost"
                    android:stateListAnimator="@null"
                    android:text="Wifi only"
                    android:textAllCaps="false"
                    android:textColor="@color/ux_text" />
            </LinearLayout>
        </LinearLayout>

        <!-- ==== DIRECT REACHABILITY (Tier 2) ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/MaximaSectionLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="DIRECT REACHABILITY  ·  A PUBLIC ADDRESS WHEN POSSIBLE" />

                <TextView
                    android:id="@+id/q_direct"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:text="?"
                    android:textColor="@color/ux_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/direct_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ==== LOG ==== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/MaximaSectionLabel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="EVENT LOG" />

                <TextView
                    android:id="@+id/q_log"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:text="?"
                    android:textColor="@color/ux_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_clear_log"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="clear"
                    android:textColor="@color/ux_subtext"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/log"
                style="@style/MaximaMono"
                android:layout_marginTop="4dp"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
