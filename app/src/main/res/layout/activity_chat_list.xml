<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_list_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <Button
        android:id="@+id/btn_new_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:text="New group" />

    <!-- The empty view sits in the same slot as the list rather than being
         wired via setEmptyView, so it can carry an explanation of WHY the
         list is empty and what to do about it. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/conversations"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#33888888"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/chat_list_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="28dp"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
