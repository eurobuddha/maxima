<?xml version="1.0" encoding="utf-8"?>
<!-- Maxima's palette — an all-greyscale WhatsApp-class messenger (user's choice).
     Soft warm greys, no colour accent; the only non-grey is the semantic red for
     errors (fund safety) and a muted green/amber for tiny status dots. This file
     is the LIGHT palette; res/values-night/colors.xml is the dark one, so the app
     follows the system light/dark setting. -->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- grounds & surfaces -->
    <color name="ux_bg">#FFF5F4F1</color>
    <color name="ux_chat_bg">#FFF5F4F1</color>
    <color name="ux_card">#FFFFFFFF</color>
    <color name="ux_card2">#FFEFEEEB</color>
    <color name="ux_input">#FFEFEEEB</color>
    <color name="ux_divider">#FFEBE9E6</color>
    <color name="ux_press">#14000000</color>
    <color name="ux_scrim">#66000000</color>

    <!-- header (the WhatsApp-style top bar) -->
    <color name="ux_header">#FF2A2E33</color>
    <color name="ux_on_header">#FFFFFFFF</color>

    <!-- text -->
    <color name="ux_text">#FF23262B</color>
    <color name="ux_subtext">#FF797C82</color>

    <!-- the single interactive "accent" is dark grey (FAB, badge, controls) -->
    <color name="ux_accent">#FF2A2E33</color>
    <color name="ux_accent_press">#FF3B4049</color>
    <color name="ux_accent_glow">#142A2E33</color>
    <color name="ux_on_accent">#FFFFFFFF</color>
    <color name="ux_banner">#14000000</color>
    <color name="ux_selected">#11000000</color>

    <!-- semantic (small, not the accent) -->
    <color name="ux_success">#FF4F9B72</color>
    <color name="ux_error">#FFC0503C</color>
    <color name="ux_pending">#FFB98A3C</color>

    <!-- chat: bubbles, their text, and the read tick — all greyscale -->
    <color name="ux_bubble_in">#FFFFFFFF</color>
    <color name="ux_bubble_in_text">#FF23262B</color>
    <color name="ux_bubble_out">#FF31353C</color>
    <color name="ux_bubble_out_text">#FFFFFFFF</color>
    <color name="ux_bubble_out_sub">#FFB6B9C1</color>
    <color name="ux_tick_read">#FF6B6F76</color>

    <color name="ic_launcher_background">#16111F</color>
</resources>
