<?xml version="1.0" encoding="utf-8"?>
<!-- Maxima's OWN palette (deliberately diverged from the utxo/atomix/wallet
     family, with the user's sign-off) so it can be a proper messenger: a
     premium light + dark system adapted from FreezePeach's "Ink" (light) and
     "Onyx Electric" (dark) design language.

     This file is the LIGHT ("Ink") palette; res/values-night/colors.xml holds
     the DARK ("Onyx Electric") one. Because everything reads @color/ux_*, the
     app follows the system light/dark setting for free.

     Brand note: the accent stays Bitcoin-orange (Maxima's identity), while the
     SENT chat bubble is WhatsApp-green - orange chrome + green bubbles. -->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <color name="ux_bg">#FFF7F6F3</color>
    <color name="ux_card">#FFFFFFFF</color>
    <color name="ux_card2">#FFEFEDE8</color>
    <color name="ux_accent">#FFF7931A</color>
    <color name="ux_accent_glow">#1AF7931A</color>
    <color name="ux_on_accent">#FF16100A</color>
    <color name="ux_text">#FF1A1712</color>
    <color name="ux_subtext">#FF9C948A</color>
    <color name="ux_input">#FFEEEBE5</color>
    <color name="ux_success">#FF1F9E5A</color>
    <color name="ux_error">#FFD93A2B</color>
    <color name="ux_pending">#FFCA8A2E</color>
    <color name="ux_banner">#33F7931A</color>
    <color name="ux_selected">#22F7931A</color>
    <color name="ux_divider">#12000000</color>
    <color name="ux_press">#14000000</color>
    <color name="ux_scrim">#66000000</color>

    <!-- Chat only: the two bubbles, their text, and the read tick. -->
    <color name="ux_bubble_in">#FFEEEBE5</color>
    <color name="ux_bubble_in_text">#FF1A1712</color>
    <color name="ux_bubble_out">#FF25D366</color>
    <color name="ux_bubble_out_text">#FF0A1F12</color>
    <color name="ux_tick_read">#FF34B7F1</color>

    <color name="ic_launcher_background">#16111F</color>
</resources>
