<?xml version="1.0" encoding="utf-8"?>
<!--
    Parlons launcher foreground. Chat-first + privacy: a speech bubble with a
    keyhole punched through it. Greyscale, matching the app's ux_* design system
    (no stock glyphs — drawn as vector paths). 108x108 adaptive foreground; art
    sits inside the ~18dp safe-zone margin.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Speech bubble with a tail at the bottom-left. -->
    <path
        android:fillColor="#EDEFF2"
        android:pathData="M34,26 H74 A12,12 0 0 1 86,38 V56 A12,12 0 0 1 74,68 H48 L38,80 L40,68 H34 A12,12 0 0 1 22,56 V38 A12,12 0 0 1 34,26 Z" />

    <!-- Keyhole, painted in the background colour so it reads as a cut-out. -->
    <path
        android:fillColor="#15171B"
        android:pathData="M54,37 A7,7 0 1 1 53.99,37 Z M51,49 H57 L55,59 H53 Z" />
</vector>
