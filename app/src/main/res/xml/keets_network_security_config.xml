<?xml version="1.0" encoding="utf-8"?>
<!-- The keets worklet serves its API as plain HTTP on 127.0.0.1 (in-process
     loopback, token-authenticated). Newer Android builds enforce the cleartext
     block for loopback too, so permit it EXPLICITLY - and only for loopback;
     everything else keeps the platform default (blocked). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
