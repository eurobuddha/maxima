<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools" xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to reach the Minima Core node app on Android 11+; without this
         a targeted setPackage() broadcast is silently dropped. -->
    <queries>
        <package android:name="org.minimarex.minimacore" />
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Same-WiFi direct P2P: NSD/mDNS discovery needs a held MulticastLock on most
         devices, or discovery silently receives nothing. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- specialUse, NOT dataSync: dataSync foreground services are capped at
         roughly 6h/day on Android 14/15, which kills an overnight connection. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Starting a foreground service from a broadcast receiver is only legal
         with the battery-optimisation exemption. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Handler.postDelayed does not survive Doze; only an exact
         allow-while-idle alarm fires reliably overnight. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The IPC surface is guarded by this SIGNATURE-level permission: only an
         app signed with the same key (the family release key) can send to it.
         A BroadcastReceiver cannot verify its caller, so without this any
         installed app could impersonate an approved one and act as the user's
         identity. We both DEFINE it (so family apps can hold it) and REQUIRE it
         on the receiver below. -->
    <permission
        android:name="com.eurobuddha.maxima.app.permission.USE_MAXIMA"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.eurobuddha.maxima.app.permission.USE_MAXIMA" />
    <!-- Maxima is the family's IPC transport hub: it must read the signature of
         ANY companion app that calls it, to prove the caller is family-signed
         before acting as the user's identity. On Android 11+ that requires
         seeing the package - a <queries> list can't enumerate future companions,
         so the hub legitimately needs broad visibility. (Not a Play app.) -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".MaximaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Maxima">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The conversation screen. Exported=false: the only ways in are our
             own Chats tab and our own notification. -->
        <activity
            android:name=".chat.ChatActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".MaximaService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Peer-to-peer messaging transport that must hold a
                    persistent connection so messages can be received while the
                    device is idle." />
        </service>

        <receiver
            android:name=".HeartbeatReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- OUTWARD IPC: how Minima Core and other companion apps use us as
             their transport. Mirrors the minimaapi broadcast pattern so it is
             familiar to anything already talking to the node. -->
        <receiver
            android:name=".ipc.MaximaApiReceiver"
            android:exported="true"
            android:permission="com.eurobuddha.maxima.app.permission.USE_MAXIMA">
            <intent-filter>
                <action android:name="com.eurobuddha.maxima.app.REGISTER" />
                <action android:name="com.eurobuddha.maxima.app.SEND" />
                <action android:name="com.eurobuddha.maxima.app.SUBSCRIBE" />
                <action android:name="com.eurobuddha.maxima.app.IDENTITY" />
                <action android:name="com.eurobuddha.maxima.app.CONTACTS" />
                <action android:name="com.eurobuddha.maxima.app.MEDIA" />
            </intent-filter>
            <!-- Media PUT carries the payload as a content:// data URI. Android's
                 intent resolution requires a <data> element for a broadcast that
                 has a data URI, so WITHOUT this the put broadcast silently fails
                 to match and is never delivered - the media IPC would hang until
                 the client's timeout. (get has no data URI and matches above.) -->
            <intent-filter>
                <action android:name="com.eurobuddha.maxima.app.MEDIA" />
                <data android:scheme="content" android:mimeType="*/*" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.eurobuddha.maxima.app.payloads"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
