<!--
  Maxima status-bar icon.

  Deliberately NOT a data-transfer arrow. It is the Maxima mark: an "M" drawn as
  three connected network nodes (a little mesh), which reads as "a comms service
  is connected", not "your data is being uploaded".

  Status-bar icons are drawn white-on-transparent; the system tints them.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- the M skeleton: up the left leg, in to the centre node, out to the right leg -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M6.5,18 L6.5,9 L12,13.5 L17.5,9 L17.5,18" />

    <!-- the three nodes -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M4.6,7.2 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M15.6,7.2 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M10.1,15.6 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0 Z" />
</vector>
