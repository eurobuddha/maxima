<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ux_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/l10n_wallet_your_address"
            android:tag="l10n:text=l10n_wallet_your_address"
            android:textColor="@color/ux_subtext"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <ImageView
            android:id="@+id/rcvQr"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:background="@color/white"
            android:padding="8dp" />

        <TextView
            android:id="@+id/rcvAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="@color/ux_card"
            android:textColor="@color/ux_text"
            android:textSize="13sp"
            android:fontFamily="monospace"
            android:textIsSelectable="true"
            android:gravity="center" />

        <Button
            android:id="@+id/rcvCopy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/l10n_contacts_copy_address"
            android:tag="l10n:text=l10n_contacts_copy_address"
            android:backgroundTint="@color/ux_accent"
            android:textColor="@color/black" />

        <Button
            android:id="@+id/rcvRefresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/l10n_node_wallet_next_address"
            android:tag="l10n:text=l10n_node_wallet_next_address"
            style="?attr/materialButtonOutlinedStyle" />

        <!-- Address safety report (checkaddress on our own address) -->
        <TextView
            android:id="@+id/rcvSafety"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="10dp"
            android:textSize="12sp"
            android:gravity="center"
            android:visibility="gone" />

        <!-- All wallet addresses; tap one to show it in the QR above -->
        <TextView
            android:id="@+id/rcvListLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/l10n_node_wallet_address_pool"
            android:tag="l10n:text=l10n_node_wallet_address_pool"
            android:textColor="@color/ux_subtext"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/rcvList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
