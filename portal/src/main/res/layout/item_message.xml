<?xml version="1.0" encoding="utf-8"?>
<!-- One bubble. Gravity and background come from entry.mine in code, so a
     single layout serves both sides and they cannot drift apart. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bubble_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <LinearLayout
        android:id="@+id/bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="300dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="9dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/bubble_sender"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:textColor="@color/ux_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- media bubble: shown for photo/video messages, else GONE -->
        <ImageView
            android:id="@+id/bubble_image"
            android:layout_width="220dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_marginBottom="4dp"
            android:scaleType="fitCenter"
            android:contentDescription="media"
            android:visibility="gone" />

        <!-- voice-note bubble omitted in the portal: v1 has no voice notes, and the app's
             WaveformView was not copied. CloudChatActivity's gone(@id/bubble_audio) no-ops. -->

        <TextView
            android:id="@+id/bubble_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.12"
            android:textColor="@color/ux_bubble_in_text"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/bubble_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="3dp"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
