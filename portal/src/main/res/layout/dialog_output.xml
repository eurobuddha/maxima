<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:tag="l10n:text=l10n_txn_workbench_output_body"
            android:text="@string/l10n_txn_workbench_output_body" />

        <EditText
            android:id="@+id/out_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="l10n:hint=l10n_wallet_amount_hint"
            android:hint="@string/l10n_wallet_amount_hint"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/out_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="l10n:hint=l10n_txn_workbench_address_hint"
            android:hint="@string/l10n_txn_workbench_address_hint"
            android:inputType="text|textNoSuggestions" />

        <EditText
            android:id="@+id/out_tokenid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="l10n:hint=l10n_txn_workbench_token_hint"
            android:hint="@string/l10n_txn_workbench_token_hint"
            android:inputType="text|textNoSuggestions" />

        <CheckBox
            android:id="@+id/out_storestate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="l10n:text=l10n_txn_workbench_storestate"
            android:text="@string/l10n_txn_workbench_storestate" />

    </LinearLayout>
</ScrollView>
