<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/ide_bg"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/txn_id"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:typeface="monospace"
            android:textSize="14sp"
            android:textColor="@color/ide_text"
            android:textColorHint="@color/ide_dim"
            android:tag="l10n:hint=l10n_txn_workbench_id_hint"
            android:hint="@string/l10n_txn_workbench_id_hint"
            android:inputType="text|textNoSuggestions" />

        <Button
            android:id="@+id/txn_create"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="l10n:text=l10n_common_create"
            android:text="@string/l10n_common_create" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:typeface="monospace"
        android:textSize="11sp"
        android:textColor="@color/ide_dim"
        android:paddingBottom="4dp"
        android:tag="l10n:text=l10n_txn_workbench_flow"
        android:text="@string/l10n_txn_workbench_flow" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/txn_addinput" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:tag="l10n:text=l10n_txn_workbench_input"
                android:text="@string/l10n_txn_workbench_input" />
            <Button android:id="@+id/txn_addoutput" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:tag="l10n:text=l10n_txn_workbench_output"
                android:text="@string/l10n_txn_workbench_output" />
            <Button android:id="@+id/txn_change" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:tag="l10n:text=l10n_txn_workbench_change"
                android:text="@string/l10n_txn_workbench_change" />
            <Button android:id="@+id/txn_setstate" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:tag="l10n:text=l10n_txn_workbench_state"
                android:text="@string/l10n_txn_workbench_state" />
            <Button android:id="@+id/txn_sign" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:tag="l10n:text=l10n_txn_workbench_sign"
                android:text="@string/l10n_txn_workbench_sign" />
            <Button android:id="@+id/txn_basics" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:tag="l10n:text=l10n_txn_workbench_basics"
                android:text="@string/l10n_txn_workbench_basics" />
            <Button android:id="@+id/txn_post" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:tag="l10n:text=l10n_txn_workbench_post"
                android:text="@string/l10n_txn_workbench_post" />

        </LinearLayout>

    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/txn_check" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:tag="l10n:text=l10n_script_editor_check"
                android:text="@string/l10n_script_editor_check" />
            <Button android:id="@+id/txn_export" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:tag="l10n:text=l10n_terminal_export"
                android:text="@string/l10n_terminal_export" />
            <Button android:id="@+id/txn_import" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:tag="l10n:text=l10n_android_wallet_import"
                android:text="@string/l10n_android_wallet_import" />
            <Button android:id="@+id/txn_list" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:tag="l10n:text=l10n_txn_workbench_list_all"
                android:text="@string/l10n_txn_workbench_list_all" />
            <Button android:id="@+id/txn_delete" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:tag="l10n:text=l10n_scripts_delete"
                android:text="@string/l10n_scripts_delete" />

        </LinearLayout>

    </HorizontalScrollView>

    <TextView
        android:id="@+id/txn_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:typeface="monospace"
        android:textSize="12sp"
        android:textColor="@color/ide_text"
        android:padding="6dp"
        android:background="@color/ide_bg_light"
        android:tag="l10n:text=l10n_txn_workbench_empty"
        android:text="@string/l10n_txn_workbench_empty" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="6dp">

        <TextView
            android:id="@+id/txn_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:typeface="monospace"
            android:textSize="12sp"
            android:textIsSelectable="true"
            android:textColor="@color/ide_dim"
            android:tag="l10n:text=l10n_txn_workbench_help"
            android:text="@string/l10n_txn_workbench_help" />

    </ScrollView>

</LinearLayout>
